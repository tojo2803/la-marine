# Copie ce fichier en .env et remplis tes propres valeurs.
# Ne JAMAIS committer le fichier .env (déjà ignoré via .gitignore).

# Serveur
PORT=3000
NODE_ENV=development

# Base de données PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=la_marine
DB_USER=la_marine_app
DB_PASSWORD=change-me

# Authentification back-office (JWT)
JWT_SECRET=change-me-with-a-long-random-string
JWT_EXPIRES_IN=8h

# Front-end autorisé (CORS)
CLIENT_ORIGIN=http://localhost:5173
